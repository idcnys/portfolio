"use client";

import React, { useState, useEffect } from "react";
import { useRouter } from "next/navigation";
import { ActivityLog, DashboardTab, TabType } from "../../../lib/types";
import {
  subscribeToContent,
  subscribeToNotes,
  subscribeToLogs,
  logActivity,
  subscribeToPortfolioSettings,
  subscribeToMedia,
} from "../../../lib/firebase";
import { ThemeProvider, useTheme } from "../../../lib/context/ThemeContext";
import ThemeToggle from "../../../components/client/ThemeToggle";
import NotepadTab from "../../../components/admin/NotepadTab";
import PublishContentTab from "../../../components/admin/PublishContentTab";
import ManageContentTab from "../../../components/admin/ManageContentTab";
import ManageExperienceTab from "../../../components/admin/ManageExperienceTab";
import CodespaceTab from "../../../components/admin/CodespaceTab";
import PortfolioConfigTab from "../../../components/admin/PortfolioConfigTab";
import MediaTab from "../../../components/admin/MediaTab";
import LogsTab from "../../../components/admin/LogsTab";
import { useContentManager } from "./hooks/useContentManager";
import { useNotesManager } from "./hooks/useNotesManager";
import { useMediaManager } from "./hooks/useMediaManager";
import { useCodespaceManager } from "./hooks/useCodespaceManager";
import { usePortfolioConfigManager } from "./hooks/usePortfolioConfigManager";
import { useExperienceManager } from "./hooks/useExperienceManager";
import { 
  Info, 
  Plus, 
  FileText, 
  Edit as EditIcon, 
  Trash2 as TrashIcon, 
  Save, 
  X, 
  Code2, 
  Maximize2, 
  Link as LinkIcon, 
  Image as ImagesIcon,
  Image as ImageIcon,
  List, 
  Globe, 
  Quote, 
  Table, 
  AlertTriangle, 
  Minus, 
  Filter, 
  Ghost, 
  ExternalLink, 
  History,
  Search as SearchIcon,
  Check,
  Clock,
  LayoutGrid,
  Hash,
  MessageSquare as MessageIcon,
  LogOut,
  Send,
  Paperclip,
  Zap,
  ChevronRight,
  StickyNote,
  Calendar,
  Terminal as TerminalIcon,
  Settings,
  ChevronLeft,
  Settings2,
  Lock,
  Eye,
  RefreshCcw,
  PlusCircle,
  Folder,
  Sliders,
  User,
  Layout,
  Cpu,
  Shield,
  Layers as LayersIcon,
  Activity,
  Inbox,
  Loader2,
  LogIn
} from "lucide-react";

const GithubIcon = (props: any) => (
  <svg {...props} xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M15 22v-4a4.8 4.8 0 0 0-1-3.5c3 0 6-2 6-5.5.08-1.25-.27-2.48-1-3.5.28-1.15.28-2.35 0-3.5 0 0-1 0-3 1.5-2.64-.5-5.36-.5-8 0C6 2 5 2 5 2c-.28 1.15-.28 2.35 0 3.5-.73 1.02-1.08 2.25-1 3.5 0 3.5 3 5.5 6 5.5-.39.49-.68 1.05-.85 1.65-.17.6-.22 1.23-.15 1.85v4"/><path d="M9 18c-4.51 2-5-2-7-2"/></svg>
);

const TwitterIcon = (props: any) => (
  <svg {...props} xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>
);

const YoutubeIcon = (props: any) => (
  <svg {...props} xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.33 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"/></svg>
);

const LinkedinIcon = (props: any) => (
  <svg {...props} xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"/><rect width="4" height="12" x="2" y="9"/><circle cx="4" cy="4" r="2"/></svg>
);

interface DashboardProps {
  onLogout: () => void;
}

const TAB_ORDER: TabType[] = [
  "certificates",
  "experience",
  "projects",
  "activity",
  "grind",
  "skillset",
];

const Dashboard: React.FC<DashboardProps> = ({ onLogout }) => {
  const [activeTab, setActiveTab] = useState<DashboardTab>("notepad");
  const [message, setMessage] = useState({ text: "", type: "" });
  const [logs, setLogs] = useState<ActivityLog[]>([]);
  const { isDarkMode } = useTheme();

  // Domain hooks
  const content = useContentManager(setMessage);
  const notesManager = useNotesManager(setMessage);
  const mediaManager = useMediaManager(setMessage);
  const config = usePortfolioConfigManager(setMessage);
  const codespace = useCodespaceManager(setMessage, config.portfolioSettings);
  const experience = useExperienceManager(setMessage, config.portfolioSettings);

  // Firebase subscriptions
  useEffect(() => {
    const unsubscribeContent = subscribeToContent(content.setItems);
    const unsubscribeNotes = subscribeToNotes(notesManager.setNotes);
    const unsubscribeLogs = subscribeToLogs(setLogs);
    const unsubscribeMedia = subscribeToMedia(mediaManager.setMedia);
    const unsubscribeSettings = subscribeToPortfolioSettings(
      config.handleSettingsSubscription
    );

    logActivity("view", "auth", "dashboard", "Admin Dashboard");

    return () => {
      unsubscribeContent();
      unsubscribeNotes();
      unsubscribeLogs();
      unsubscribeMedia();
      unsubscribeSettings();
    };
  }, []);

  const tabs = [
    { id: "notepad" as DashboardTab, label: "Personal Notepad", Icon: StickyNote },
    { id: "publish-project" as DashboardTab, label: "Publish Project", Icon: Code2 },
    { id: "publish-activity" as DashboardTab, label: "Publish Activity", Icon: Calendar },
    { id: "manage-content" as DashboardTab, label: "Manage Content", Icon: EditIcon },
    { id: "manage-experience" as DashboardTab, label: "Manage Experience", Icon: PlusCircle },
    { id: "media" as DashboardTab, label: "Upload Images", Icon: ImageIcon },
    { id: "codespace" as DashboardTab, label: "Codespace", Icon: TerminalIcon },
    { id: "portfolio-config" as DashboardTab, label: "Portfolio Config", Icon: Sliders },
    { id: "logs" as DashboardTab, label: "View Portfolio Logs", Icon: History },
    { id: "logout" as DashboardTab, label: "Log out", Icon: LogOut },
  ];

  const handleTabClick = async (tabId: DashboardTab) => {
    if (tabId === "logout") {
      await logActivity("logout", "auth", "dashboard", "Admin Dashboard");
      onLogout();
      return;
    }
    setActiveTab(tabId);
    if (tabId === "publish-project") {
      content.setFormData((prev) => ({ ...prev, type: "project" }));
    } else if (tabId === "publish-activity") {
      content.setFormData((prev) => ({ ...prev, type: "activity" }));
    }
  };

  const formatTimestamp = (timestamp: string) =>
    new Date(timestamp).toLocaleString();

  const getActionColor = (action: string) => {
    switch (action) {
      case "login":
        return "text-green-600 bg-green-50 dark:text-green-200 dark:bg-green-900/30";
      case "logout":
        return "text-orange-600 bg-orange-50 dark:text-orange-200 dark:bg-orange-900/30";
      case "create":
        return "text-blue-600 bg-blue-50 dark:text-blue-200 dark:bg-blue-900/30";
      case "edit":
        return "text-yellow-600 bg-yellow-50 dark:text-yellow-200 dark:bg-yellow-900/30";
      case "delete":
        return "text-red-600 bg-red-50 dark:text-red-200 dark:bg-red-900/30";
      case "view":
        return "text-purple-600 bg-purple-50 dark:text-purple-200 dark:bg-purple-900/30";
      default:
        return "text-gray-600 bg-gray-50 dark:text-gray-200 dark:bg-gray-800";
    }
  };

  return (
    <div className="min-h-screen bg-gray-50 text-gray-900 dark:bg-gray-950 dark:text-gray-100 flex flex-col transition-colors">
      {/* Navigation */}
      <nav className="bg-white border-b border-gray-200 px-4 md:px-8 py-3 flex items-center sticky top-0 z-50 shadow-sm dark:bg-gray-950 dark:border-gray-800/50 dark:backdrop-blur-md">
        <div className="flex items-center gap-3">
          <div className="w-8 h-8 bg-[#FFDB14] rounded-lg flex items-center justify-center font-black text-base text-gray-900 shadow-md ring-2 ring-yellow-400/20">
            B
          </div>
          <span className="sr-only">Studio Admin</span>
        </div>

        <div className="flex-1 mx-4 md:mx-8 overflow-hidden">
          <div className="flex flex-wrap items-center gap-1">
            {tabs.map((tab) => (
              <button
                key={tab.id}
                onClick={() => handleTabClick(tab.id)}
                className={`flex items-center gap-2 px-3 py-2 text-xs font-bold whitespace-nowrap rounded-md border transition-all ${
                  activeTab === tab.id
                    ? "bg-[#FFDB14] text-gray-900 border-yellow-400 shadow-[0_0_15px_rgba(255,219,20,0.3)] dark:text-gray-900 dark:bg-[#FFDB14] dark:border-yellow-300 dark:shadow-[0_0_20px_rgba(255,219,20,0.4)]"
                    : "border-transparent text-gray-400 hover:text-gray-700 hover:border-gray-200 dark:text-gray-500 dark:hover:text-gray-200 dark:hover:border-gray-700"
                } ${tab.id === "logout" ? "ml-2 text-red-500 hover:text-red-600 dark:text-red-400 dark:hover:text-red-300" : ""}`}
              >
                <tab.Icon className="w-4 h-4" />
                {tab.label}
              </button>
            ))}
          </div>
        </div>

        <div className="flex items-center gap-3">
          <ThemeToggle className="w-8 h-8 rounded-full bg-gray-50 dark:bg-gray-800 border border-gray-200 dark:border-gray-700" />
        </div>
      </nav>

      {message.text && (
        <div
          className={`mx-6 md:mx-12 mt-4 px-6 py-3 rounded-2xl text-xs font-black ${
            message.type === "success"
              ? "bg-green-50 text-green-600 border border-green-200 dark:bg-green-900/30 dark:text-green-200 dark:border-green-700"
              : "bg-red-50 text-red-600 border border-red-200 dark:bg-red-900/30 dark:text-red-200 dark:border-red-700"
          }`}
        >
          <Info className="w-4 h-4 mr-2 inline" /> {message.text}
        </div>
      )}

      {/* Tab Content */}
      {activeTab === "notepad" && (
        <NotepadTab
          notes={notesManager.notes}
          selectedNote={notesManager.selectedNote}
          isEditingNote={notesManager.isEditingNote}
          noteForm={notesManager.noteForm}
          onSelectNote={notesManager.handleNoteClick}
          onNewNote={notesManager.handleNewNote}
          onSaveNote={notesManager.handleSaveNote}
          onDeleteNote={notesManager.handleDeleteNote}
          onStartEdit={() => notesManager.setIsEditingNote(true)}
          onCancelEdit={() => notesManager.setIsEditingNote(false)}
          onUpdateNoteForm={(updates) => notesManager.setNoteForm((prev) => ({ ...prev, ...updates }))}
          formatTimestamp={formatTimestamp}
        />
      )}

      {(activeTab === "publish-project" || activeTab === "publish-activity") && (
        <PublishContentTab
          formData={content.formData}
          tagsInput={content.tagsInput}
          editingId={content.editingId}
          isLoading={content.isLoading}
          onUpdateFormData={(updates) => content.setFormData((prev) => ({ ...prev, ...updates }))}
          onUpdateLinks={(key, value) => content.setFormData((prev) => ({ ...prev, links: { ...prev.links, [key]: value } }))}
          onTagsInputChange={content.setTagsInput}
          onSubmit={content.handleSubmit}
          onResetForm={content.resetForm}
        />
      )}

      {activeTab === "manage-content" && (
        <ManageContentTab
          items={content.items}
          onEdit={(item) => { content.handleEdit(item); setActiveTab(item.type === "project" ? "publish-project" : "publish-activity"); }}
          onDelete={content.handleDelete}
        />
      )}

      {activeTab === "manage-experience" && (
        <ManageExperienceTab
          experiences={config.portfolioSettings?.experiences || []}
          experienceForm={experience.experienceForm}
          experienceStackInput={experience.experienceStackInput}
          editingExperienceId={experience.editingExperienceId}
          onUpdateForm={(updates) => experience.setExperienceForm((prev) => ({ ...prev, ...updates }))}
          onStackInputChange={experience.setExperienceStackInput}
          onSave={experience.saveExperienceItem}
          onCancelEdit={experience.resetExperienceForm}
          onEdit={experience.handleEditExperience}
          onDelete={experience.deleteExperienceItem}
          onMarkLatest={experience.markExperienceAsLatest}
        />
      )}

      {activeTab === "codespace" && (
        <CodespaceTab
          githubTokenInput={codespace.githubTokenInput}
          codespaceCode={codespace.codespaceCode}
          githubUser={codespace.githubUser}
          repoList={codespace.repoList}
          selectedRepo={codespace.selectedRepo}
          repoEntries={codespace.repoEntries}
          repoPath={codespace.repoPath}
          repoNameInput={codespace.repoNameInput}
          repoVisibility={codespace.repoVisibility}
          filePathInput={codespace.filePathInput}
          commitMessage={codespace.commitMessage}
          codespaceBusy={codespace.codespaceBusy}
          hasSavedToken={!!config.portfolioSettings?.githubToken?.trim()}
          onGithubTokenInputChange={codespace.setGithubTokenInput}
          onSaveGithubToken={codespace.handleSaveGithubToken}
          onClearGithubToken={codespace.handleClearGithubToken}
          onLoadRepos={codespace.handleLoadRepos}
          onSelectRepo={codespace.setSelectedRepo}
          onRepoNameInputChange={codespace.setRepoNameInput}
          onRepoVisibilityChange={codespace.setRepoVisibility}
          onCreateRepo={codespace.handleCreateRepo}
          onFilePathInputChange={codespace.setFilePathInput}
          onCommitMessageChange={codespace.setCommitMessage}
          onLoadFile={codespace.handleLoadFile}
          onSaveFile={codespace.handleSaveFile}
          onLoadRepoEntries={codespace.loadRepoEntries}
          onLoadFileByPath={codespace.loadFileByPath}
          onCodespaceCodeChange={codespace.setCodespaceCode}
        />
      )}

      {activeTab === "portfolio-config" && (
        <PortfolioConfigTab
          homeForm={config.homeForm}
          setHomeForm={config.setHomeForm}
          saveHomeSettings={config.saveHomeSettings}
          usernameForm={config.usernameForm}
          setUsernameForm={config.setUsernameForm}
          saveUsernames={config.saveUsernames}
          tabOrder={TAB_ORDER}
          tabVisibility={config.portfolioSettings?.tabVisibility}
          toggleTabVisibility={config.toggleTabVisibility}
          grindCardsEditor={config.grindCardsEditor}
          setGrindCardsEditor={config.setGrindCardsEditor}
          grindRatingsEditor={config.grindRatingsEditor}
          setGrindRatingsEditor={config.setGrindRatingsEditor}
          grindGithubEditor={config.grindGithubEditor}
          setGrindGithubEditor={config.setGrindGithubEditor}
          skillsetEditor={config.skillsetEditor}
          setSkillsetEditor={config.setSkillsetEditor}
          saveGrindAndSkillset={config.saveJsonEditors}
        />
      )}

      {activeTab === "media" && (
        <MediaTab
          media={mediaManager.media}
          isUploading={mediaManager.isUploading}
          onImageUpload={mediaManager.handleImageUpload}
          onDeleteMedia={mediaManager.handleDeleteMedia}
          onCopyLink={mediaManager.copyToClipboard}
        />
      )}

      {activeTab === "logs" && (
        <LogsTab
          logs={logs}
          formatTimestamp={formatTimestamp}
          getActionColor={getActionColor}
        />
      )}
    </div>
  );
};

const DashboardPage: React.FC = () => {
  const router = useRouter();

  const handleLogout = async () => {
    await fetch("/api/admin/logout", {
      method: "POST",
    });
    router.push("/admin/login");
  };

  return (
    <ThemeProvider>
      <Dashboard onLogout={handleLogout} />
    </ThemeProvider>
  );
};

export default DashboardPage;
